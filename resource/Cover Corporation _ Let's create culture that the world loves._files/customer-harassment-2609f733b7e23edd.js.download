(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[2457],{14310:(e,t,i)=>{"use strict";i.r(t),i.d(t,{default:()=>m});var n=i(66284),r=i(62867),s=i(85288),o=i(52104),l=i(18153),c={title:"カスタマーハラスメントに対する基本方針 | カバー株式会社",description:"",openGraph:{title:"カスタマーハラスメントに対する基本方針 | カバー株式会社"}},p={BasicApproach:{title:"1　基本的な考え方",text:(0,l.FD)(l.FK,{children:[(0,l.Y)("p",{children:"カバー株式会社（以下「当社」という）は、ホロライブプロダクションをはじめとするVTuber・バーチャルタレント事業を通じて、世界中のファンの皆さまに感動と楽しさをお届けすることを使命としております。"}),(0,l.Y)("p",{children:"当社は、ファンの皆さまからのご意見・ご要望・応援のお声を真摯に受け止め、タレント活動およびコンテンツの向上に活かしてまいります。"}),(0,l.Y)("p",{children:"その一方で、一部のお客さまより、当社の役職員・所属タレント・業務委託先および関係各社の従業員（以下「当社関係者」という）に対し、SNS・動画配信プラットフォーム・ライブ配信のコメント（課金機能を通じて行われるものも含む）・ファンメール・問い合わせフォーム・リアルイベント会場等を通じて、社会通念上相当な範囲を超える言動（以下「カスタマーハラスメント」という）が行われている実態があります。"}),(0,l.Y)("p",{children:"カスタマーハラスメントは、当社関係者の心身の健全性を損ない、ひいては良質なコンテンツをお届けする体制を毀損するものです。当社は、「労働施策の総合的な推進並びに労働者の雇用の安定及び職業生活の充実等に関する法律」の趣旨を踏まえ、当社関係者が安全かつ安心して活動・業務に従事できる環境を確保するため、本方針を定め、カスタマーハラスメントに毅然と対応いたします。"})]})},Definition:{title:"2　カスタマーハラスメントの定義",text:(0,l.FD)(l.FK,{children:[(0,l.Y)("p",{children:"当社は、厚生労働省「カスタマーハラスメント対策企業マニュアル」に基づき、カスタマーハラスメントを次のとおり定義します。"}),(0,l.Y)("blockquote",{children:"お客さまからの要求・言動のうち、当該要求内容の妥当性に照らして、当該要求を実現するための手段・態様が社会通念上不相当なものであって、当社関係者の就業環境・活動環境が害されるもの"})]})},Conduct:{title:"3　カスタマーハラスメントに該当する行為",lead:(0,l.Y)("p",{children:"下記の行為はカスタマーハラスメントに該当するものとして取り扱います。なお、以下はあくまで例示であり、これらに限定されません。"}),subTitle1:"（1）ハラスメント行為",list1:["暴力行為、脅迫的言動、または威嚇","暴言、侮辱的発言、人格否定","当社関係者に対する名誉毀損・侮辱的投稿（SNS・掲示板・動画コメント等を含む）","加害予告・業務妨害予告","過度かつ執拗な問い合わせ・DM送信・コメント投稿の繰り返し","ストーカー行為、つきまとい行為（オンライン上の行為を含む。ストーカー規制法2条1項各号参照）","無断撮影・録音・録画およびその無断公開","性的嫌がらせ、差別的言動","オフィスへ無許可で立ち入ろうとする行為"],subTitle2:"（2）不当要求行為",list2:["合理的根拠なくタレントの活動内容・キャスティング・コラボレーション等の変更・取消しを要求すること","合理的根拠なく当社関係者の処罰・謝罪・降格等を要求すること","社会通念上相当な範囲を超えたグッズ・チケット・デジタルコンテンツ等の提供を要求すること","当社の商品・サービスとは無関係な要求を繰り返すこと","チャット、コメント、ギフト等を用いて過剰かつ反復的な要求を行うこと"]},Response:{title:"4　当社の対応方針",subTitle1:"（1）サービス提供の制限・停止",text1:(0,l.Y)("p",{children:"カスタマーハラスメントに該当すると判断した場合、当社は、カスタマーサービスの提供を制限・停止するとともに、動画配信プラットフォーム・SNS等における当該アカウントのブロック・通報・Ban申請等の措置を講じることがあります。"}),subTitle2:"（2）法的対応",text2:(0,l.Y)("p",{children:"当該行為が悪質と判断される場合には、弁護士に委任のうえ、以下を含む法的措置を講じます。"}),list2:["発信者情報開示請求（プロバイダ責任制限法5条以下）","民事上の損害賠償請求（民法709条・710条・723条）","刑事告訴・告発（脅迫罪〔刑法222条〕・強要罪〔同223条〕・名誉毀損罪〔同230条〕・侮辱罪〔同231条〕・業務妨害罪〔同234条〕・ストーカー規制法違反等）","仮処分申立（投稿削除・接近禁止等）"],subTitle3:"（3）警察・行政との連携",text3:(0,l.Y)("p",{children:"身体的危害の予告等、緊急性が認められる事案については、直ちに警察に通報・連携します。"}),subTitle4:"（4）当社関係者の保護",text4:(0,l.Y)("p",{children:"当社は、カスタマーハラスメントを受けた当社関係者に対して、適切なメンタルヘルスケアその他の支援を提供し、被害者の二次被害防止に努めます。"})},Request:{title:"5　ファンの皆さまへのお願い",text:(0,l.FD)(l.FK,{children:[(0,l.Y)("p",{children:"ホロライブをはじめとする当社のタレント・コンテンツをご支持いただいているファンの皆さまには、当社関係者が安心して活動を継続できる環境及び健全な労働環境の維持に、引き続きご理解とご協力をお願いいたします。"}),(0,l.Y)("p",{children:"皆さまの温かい応援が、タレントにとってかけがえのない力となっております。"})]})}};function a(e,t){var i=Object.keys(e);if(Object.getOwnPropertySymbols){var n=Object.getOwnPropertySymbols(e);t&&(n=n.filter(function(t){return Object.getOwnPropertyDescriptor(e,t).enumerable})),i.push.apply(i,n)}return i}var d=[{text:"Top",path:"/"},{text:"カスタマーハラスメントに対する基本方針",path:"/customer-harassment"}];let m=function(){return(0,l.FD)(l.FK,{children:[(0,l.Y)(r.bV,function(e){for(var t=1;t<arguments.length;t++){var i=null!=arguments[t]?arguments[t]:{};t%2?a(Object(i),!0).forEach(function(t){(0,n.A)(e,t,i[t])}):Object.getOwnPropertyDescriptors?Object.defineProperties(e,Object.getOwnPropertyDescriptors(i)):a(Object(i)).forEach(function(t){Object.defineProperty(e,t,Object.getOwnPropertyDescriptor(i,t))})}return e}({},c)),(0,l.Y)(s.P,{pageText:p}),(0,l.Y)(o.Q,{items:d,hasMargin:!0})]})}},18202:(e,t,i)=>{"use strict";i.d(t,{e:()=>n.e});var n=i(56939)},22530:(e,t,i)=>{"use strict";i.d(t,{a:()=>c});var n=i(38993),r=i(43985),s=(0,n.AH)("font-size:1.8rem;border-bottom:1px solid var(--line);position:relative;padding-bottom:14px;line-height:1.72;margin-bottom:24px;",(0,r.mq)("md"),"{font-size:2.2rem;line-height:1.4;}&::after{content:'';disp